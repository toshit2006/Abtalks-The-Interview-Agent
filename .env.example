# Optional. When set, the interview agent uses Groq API for ultra-fast LLM grading and adaptive questions.
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile if unset.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional. When set, the agent uses Qdrant vector database for semantic retrieval (RAG) and memory.
# Example local URL: http://localhost:6333 or Qdrant Cloud cluster URL
QDRANT_URL=
QDRANT_API_KEY=


