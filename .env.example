# Optional. When set, the interview agent uses Claude to grade answers,
# write adaptive follow-up questions, and write the final report summary.
# Without it, the app still runs end-to-end using the built-in deterministic
# scoring/templating engine in src/lib/interview-engine.ts — just less adaptive.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=
